{
    "name": "@dylanebert/shallot-avbd-physics",
    "version": "0.10.0",
    "description": "AVBD GPU rigid-body solver for Shallot, plugged in through the physics/core seam.",
    "license": "MIT",
    "author": "Dylan Ebert <dylan.ebert@gmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/dylanebert/shallot-avbd-physics.git"
    },
    "homepage": "https://github.com/dylanebert/shallot-avbd-physics",
    "bugs": "https://github.com/dylanebert/shallot-avbd-physics/issues",
    "keywords": ["webgpu", "physics", "avbd", "shallot"],
    "type": "module",
    "sideEffects": false,
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.2"
    },
    "exports": {
        ".": "./src/index.ts",
        "./core": "./src/core.ts"
    },
    "files": ["src", "!src/**/*.test.ts"],
    "scripts": {
        "check": "tsc --noEmit && biome check && shallot test --list",
        "list": "shallot test --list",
        "test": "shallot test"
    },
    "peerDependencies": {
        "@dylanebert/shallot": "^0.10.0",
        "typegpu": "~0.12.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13",
        "@dylanebert/shallot": "github:dylanebert/shallot#69f12a06438d8ce80aa1ab9e4b34de5b58820e15",
        "@types/bun": "latest",
        "@webgpu/types": "^0.1.72",
        "bun-webgpu": "github:dylanebert/bun-webgpu#7b75d0440d2f22e2c9a1cb383d15529652c53d98",
        "typegpu": "~0.12.5",
        "typescript": "^7.0.2",
        "unplugin-typegpu": "~0.12.3"
    }
}
